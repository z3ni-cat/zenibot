# ===== IDENTITAS =====
# Nama bot yang tampil di pesan
BOT_NAME=ZeniBot
# Nama tokomu
STORE_NAME=Toko Saya
# Tagline toko
STORE_TAGLINE=Toko & Layanan Digital! 🛍️

# ===== AKSES =====
# Nomor owner (admin penuh), dipisah koma. Format: 6281234567890
OWNER_NUMBERS=6281234567890
# Nomor WA yang dipakai sebagai bot (tanpa + / spasi)
BOT_NUMBER=6281234567890
# Metode pairing: code (kode 8 digit) atau qr (scan QR)
PAIR_METHOD=code

# ===== ADMIN TAMBAHAN (opsional, kosong = ikut owner) =====
# Admin sesi tanya-stok / support (dipisah koma)
SUPPORT_ADMINS=
# Admin tools minyak goreng
MINYAK_ADMINS=
# Nomor admin penerima order Kopken manual
KOPKEN_ADMIN=

# ===== LISENSI =====
# lite (default, gratis, fitur terbatas) | premium (full version)
LICENSE_TIER=lite
# Batas produk edisi Lite
LITE_MAX_PRODUCTS=10
# Harga & kontak untuk pesan promo/upsell
FULL_PRICE=Rp150.000
SALES_CONTACT=https://wa.me/6281234567890
# Jeda pesan promo otomatis ke owner, dalam jam (0 = matikan). Lite saja.
PROMO_EVERY_HOURS=6

# ===== PEMBAYARAN (QRIS via sayabayar.com) =====
SAYABAYAR_API_KEY=
# Prefix kode invoice (default: INV -> INV-XXXXXX)
INVOICE_PREFIX=INV

# ===== LAYANAN OPSIONAL =====
# Tools gratis (downloader, cek resi, dsb) via api.neoxr.eu
NEOXR_API_KEY=
# SMM panel djuragansosmed.com
DJURAGAN_API_KEY=
DJURAGAN_PROFIT=4500
# Tools API docs (VCC, iPhone quote, MLBB, dsb)
TOOLSAPI_KEY=
# Relay generate AI via Telegram (order jasa video AI)
GEN_TG_BOT_TOKEN=
GEN_TG_CHAT_ID=
# Auto-post commit GitHub ke WA Channel
GH_TOKEN_ZENICAT=
